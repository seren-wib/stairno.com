---
import { site } from '../data/site';
import { t, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = t(locale).contact;
---

<section class="section contact" aria-labelledby="contact-title">
  <div class="container">
    <h2 id="contact-title">{copy.heading}</h2>
    <a class="contact-link" href={`mailto:${site.email}`}>
      {copy.action}
    </a>
  </div>
</section>
