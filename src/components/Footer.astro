---
import SharedFooter from '@stairno/ui/components/Footer.astro';
import { projects } from '../data/projects';
import { site } from '../data/site';
import { t, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  path?: string;
}

const { locale, path = '' } = Astro.props;
const copy = t(locale);
---

<SharedFooter
  locale={locale}
  path={path}
  brand={site.name}
  tagline={copy.hero.etymology}
  links={{
    heading: copy.footer.projects,
    items: projects.map((project) => ({ href: project.url, label: project.name[locale] })),
  }}
  source={{ href: site.github, label: copy.footer.source }}
  switchLabel={copy.nav.switchLocale}
/>
