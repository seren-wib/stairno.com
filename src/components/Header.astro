---
import { localePath, t, type Locale } from '../i18n';
import { site } from '../data/site';
import LocaleSwitch from './LocaleSwitch.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  locale: Locale;
  path?: string;
}

const { locale, path = '' } = Astro.props;
const copy = t(locale);
const sections = [
  { href: '#projects', label: copy.projects.heading },
  { href: '#news', label: copy.news.heading },
  { href: '#contact', label: copy.contact.heading },
];
---

<header class="site-header" data-sticky>
  <div class="container">
    <a class="brand" href={localePath(locale)}>
      {site.name}
    </a>
    <nav class="site-nav">
      <ul class="site-menu">
        {sections.map((item) => (
          <li>
            <a href={item.href}>{item.label}</a>
          </li>
        ))}
      </ul>
      <LocaleSwitch locale={locale} path={path} />
      <ThemeToggle locale={locale} />
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-sticky]');
  if (header) {
    const update = () => header.classList.toggle('is-solid', window.scrollY > 24);
    update();
    window.addEventListener('scroll', update, { passive: true });
  }
</script>
