---
import { localePath, type Locale } from '../i18n';
import { site } from '../data/site';
import LocaleSwitch from './LocaleSwitch.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  locale: Locale;
  path?: string;
}

const { locale, path = '' } = Astro.props;
---

<header class="site-header">
  <div class="container">
    <a class="brand" href={localePath(locale)}>
      {site.name}
    </a>
    <nav class="site-nav">
      <LocaleSwitch locale={locale} path={path} />
      <ThemeToggle locale={locale} />
    </nav>
  </div>
</header>
