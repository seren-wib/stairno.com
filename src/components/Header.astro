---
import AccountMenu from '@stairno/ui/components/AccountMenu.astro';
import SharedHeader from '@stairno/ui/components/Header.astro';
import { t, type Locale } from '../i18n';
import { site } from '../data/site';

interface Props {
  locale: Locale;
  path?: string;
}

const { locale, path = '' } = Astro.props;
const copy = t(locale);

// The current menu item is drawn in dots (src/lib/dot-text.ts).
const dotText = {
  'data-dot-text': '',
  'data-dot-trigger': 'current',
  'data-dot-spacing': '1.5',
  'data-dot-radius': '0.34',
  'data-dot-spread': '0.2',
  'data-dot-color': 'star',
};
const items = [
  { href: '#projects', label: copy.projects.heading, labelAttrs: dotText },
  { href: '#news', label: copy.news.heading, labelAttrs: dotText },
  { href: '#contact', label: copy.contact.heading, labelAttrs: dotText },
];

// FR-20: no server here, so the menu reads the session in the browser. Sign-in and sign-up come
// back to this page's locale home (account.stairno.com FR-81).
const account = `${site.accountUrl}/${locale}`;
const back = encodeURIComponent(`${site.url}/${locale}/`);
---

<SharedHeader
  locale={locale}
  path={path}
  brand={site.name}
  items={items}
  switchLabel={copy.nav.switchLocale}
  themeLabels={copy.nav.theme}
>
  <AccountMenu
    slot="actions"
    locale={locale}
    labels={copy.nav.accountMenu}
    accountUrl={`${account}/`}
    signInUrl={`${account}/sign-in?redirect=${back}`}
    signUpUrl={`${account}/sign-up?redirect=${back}`}
    signOutUrl={`${site.apiUrl}/auth/sign-out`}
    sessionUrl={`${site.apiUrl}/auth/get-session`}
  />
</SharedHeader>
