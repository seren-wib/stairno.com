---
import { site } from '../data/site';
import { t, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = t(locale).hero;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container hero-inner">
    <p class="hero-tagline">{copy.tagline}</p>
    <h1 id="hero-title" class="wordmark">
      {site.name}
    </h1>
    <p class="hero-intro">{copy.intro}</p>
    <p class="hero-etymology">{copy.etymology}</p>
  </div>
  <div class="hero-art" aria-hidden="true">
    <span class="step s1"></span>
    <span class="step s2"></span>
    <span class="step s3"></span>
    <span class="step s4"></span>
    <span class="star"></span>
  </div>
</section>
