---
import { site } from '../data/site';
import { t, type Locale } from '../i18n';
import HeroDots from './HeroDots.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = t(locale).hero;
---

<section class="hero" aria-labelledby="hero-title">
  <HeroDots />
  <div class="container hero-inner">
    <p class="hero-tagline" data-reveal="1">
      {copy.tagline}
    </p>
    <h1 id="hero-title" class="wordmark" data-reveal="2">
      {site.name}
    </h1>
    <p class="hero-intro" data-reveal="3">
      {copy.intro}
    </p>
  </div>
</section>
