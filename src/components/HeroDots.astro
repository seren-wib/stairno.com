---
// Decorative halftone canvas behind the hero copy. Draws nothing until the
// script runs, so the hero is a plain night gradient without JavaScript.
---

<canvas class="hero-dots" data-hero-dots aria-hidden="true"></canvas>

<script>
  import { dotField } from '../lib/dots';

  const SPACING = 14;
  const CLIMB_SECONDS = 2.8;
  const CLIMB_DELAY = 0.4;
  const YELLOW = { r: 255, g: 209, b: 102 };
  const HOT = { r: 255, g: 247, b: 224 };

  function mount(canvas: HTMLCanvasElement): void {
    const context = canvas.getContext('2d');
    if (!context) return;
    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let width = 0;
    let height = 0;
    let dpr = 1;
    let start = performance.now();
    let frame = 0;

    function resize(): void {
      const rect = canvas.getBoundingClientRect();
      dpr = Math.min(2, window.devicePixelRatio || 1);
      width = Math.max(1, Math.round(rect.width));
      height = Math.max(1, Math.round(rect.height));
      canvas.width = Math.round(width * dpr);
      canvas.height = Math.round(height * dpr);
      context!.setTransform(dpr, 0, 0, dpr, 0, 0);
    }

    function draw(now: number): void {
      const seconds = (now - start) / 1000;
      const progress = reduceMotion
        ? 1
        : Math.min(1, Math.max(0, (seconds - CLIMB_DELAY) / CLIMB_SECONDS));
      context!.clearRect(0, 0, width, height);
      const cols = Math.ceil(width / SPACING);
      const rows = Math.ceil(height / SPACING);
      for (let row = 0; row <= rows; row++) {
        for (let col = 0; col <= cols; col++) {
          const px = col * SPACING + SPACING / 2;
          const py = row * SPACING + SPACING / 2;
          const dot = dotField(px / width, py / height, progress, reduceMotion ? 0 : seconds);
          const r = Math.round(YELLOW.r + (HOT.r - YELLOW.r) * dot.warmth);
          const g = Math.round(YELLOW.g + (HOT.g - YELLOW.g) * dot.warmth);
          const b = Math.round(YELLOW.b + (HOT.b - YELLOW.b) * dot.warmth);
          context!.fillStyle = `rgba(${r}, ${g}, ${b}, ${dot.alpha.toFixed(3)})`;
          context!.beginPath();
          context!.arc(px, py, dot.radius * SPACING, 0, Math.PI * 2);
          context!.fill();
        }
      }
    }

    function loop(now: number): void {
      draw(now);
      frame = requestAnimationFrame(loop);
    }

    resize();
    if (reduceMotion) {
      draw(performance.now());
    } else {
      frame = requestAnimationFrame(loop);
    }

    new ResizeObserver(() => {
      resize();
      if (reduceMotion) draw(performance.now());
    }).observe(canvas);

    document.addEventListener('visibilitychange', () => {
      if (reduceMotion) return;
      if (document.hidden) {
        cancelAnimationFrame(frame);
      } else {
        start = performance.now() - (CLIMB_DELAY + CLIMB_SECONDS) * 1000;
        frame = requestAnimationFrame(loop);
      }
    });
  }

  for (const canvas of document.querySelectorAll<HTMLCanvasElement>('[data-hero-dots]')) {
    mount(canvas);
  }
</script>
