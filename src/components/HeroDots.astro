---
// Decorative halftone canvas behind the hero copy. Draws nothing until the
// script runs, so the hero is a plain night gradient without JavaScript.
// On load the whole picture sits on a dotted globe that turns in 3D, then
// unwraps flat into the staircase and the wordmark; afterwards the star
// climbs on a loop. SDD 4.2, 4.6.
---

<canvas class="hero-dots" data-hero-dots aria-hidden="true"></canvas>

<script>
  import {
    assemble,
    climbCycle,
    dotField,
    dotsFromMask,
    ripple,
    type MaskPoint,
  } from '../lib/dots';

  const SPACING = 14;
  const LETTER_SPACING = 6;
  // Globe intro: the flat picture is wrapped onto a sphere that spins into
  // view over `spin` seconds; from `unfoldAt` the dots peel off the sphere
  // to their flat places over `unfold` seconds, centre first (`spread`).
  const INTRO = { spin: 2.0, unfoldAt: 1.2, unfold: 1.5, spread: 0.5 };
  const INTRO_END = INTRO.unfoldAt + INTRO.spread + INTRO.unfold;
  const TIMING = { delay: INTRO_END, climb: 2.8, hold: 1.6, fade: 0.6 };
  // How much of the sphere the picture covers: longitude span and latitude span.
  const LON_SPAN = Math.PI * 1.7;
  const LAT_SPAN = Math.PI * 0.95;
  const START_ANGLE = -1.4; // radians the globe still has to turn at t = 0

  const easeOut = (t: number) => 1 - (1 - Math.min(1, Math.max(0, t))) ** 3;

  type Globe = { x: number; y: number; depth: number; persp: number; lon: number };

  // Where the flat point (fx, fy) sits on the globe turned by `theta`.
  function onGlobe(
    fx: number,
    fy: number,
    w: number,
    h: number,
    cx: number,
    cy: number,
    R: number,
    theta: number,
  ): Globe {
    const lon = (fx / w - 0.5) * LON_SPAN;
    const lat = (fy / h - 0.5) * LAT_SPAN;
    const cl = Math.cos(lat);
    const x3 = R * cl * Math.sin(lon + theta);
    const y3 = R * Math.sin(lat);
    const z3 = R * cl * Math.cos(lon + theta); // towards the viewer
    const depth = (z3 / R + 1) / 2; // 0 = far side, 1 = nearest
    const persp = 0.78 + 0.32 * depth;
    return { x: cx + x3 * persp, y: cy + y3 * persp, depth, persp, lon };
  }

  // On narrow canvases the staircase gets the right 70% instead of 48% and
  // sits in the lower half, under the copy.
  function fieldX(u: number, narrow: boolean): number {
    if (!narrow) return u;
    return u < 0.3 ? (u / 0.3) * 0.52 : 0.52 + ((u - 0.3) / 0.7) * 0.48;
  }
  function fieldY(u: number, narrow: boolean): number {
    if (!narrow) return u;
    return u < 0.5 ? u * 0.6 : 0.3 + ((u - 0.5) / 0.5) * 0.7;
  }

  // Click ripple: ring speed px/s, band width px, life s, push distance px.
  const WAVE = { speed: 900, width: 90, life: 1.4 };
  const PUSH = 22;

  // Dots are light grey; the star burns white.
  const YELLOW = { r: 214, g: 214, b: 214 };
  const HOT = { r: 255, g: 255, b: 255 };

  function colour(warmth: number, alpha: number): string {
    const r = Math.round(YELLOW.r + (HOT.r - YELLOW.r) * warmth);
    const g = Math.round(YELLOW.g + (HOT.g - YELLOW.g) * warmth);
    const b = Math.round(YELLOW.b + (HOT.b - YELLOW.b) * warmth);
    return `rgba(${r}, ${g}, ${b}, ${alpha.toFixed(3)})`;
  }

  function offsetWithin(el: HTMLElement, ancestor: HTMLElement): { left: number; top: number } {
    let left = 0;
    let top = 0;
    let node: HTMLElement | null = el;
    while (node && node !== ancestor) {
      left += node.offsetLeft;
      top += node.offsetTop;
      node = node.offsetParent as HTMLElement | null;
    }
    return { left, top };
  }

  // Renders the wordmark text off screen with the h1's own font and samples it.
  function wordmarkPoints(hero: HTMLElement, wordmark: HTMLElement): MaskPoint[] {
    const style = getComputedStyle(wordmark);
    const size = parseFloat(style.fontSize);
    const width = Math.ceil(wordmark.offsetWidth + LETTER_SPACING);
    const height = Math.ceil(wordmark.offsetHeight + LETTER_SPACING);
    if (width <= 0 || height <= 0) return [];
    const off = document.createElement('canvas');
    off.width = width;
    off.height = height;
    const ctx = off.getContext('2d');
    if (!ctx) return [];
    ctx.font = `${style.fontWeight} ${size}px ${style.fontFamily}`;
    ctx.textBaseline = 'alphabetic';
    ctx.fillStyle = '#fff';
    const text = wordmark.textContent?.trim() ?? '';
    const metrics = ctx.measureText(text);
    const ascent = metrics.fontBoundingBoxAscent || size * 0.8;
    const descent = metrics.fontBoundingBoxDescent || size * 0.2;
    const lineHeight = parseFloat(style.lineHeight) || size;
    ctx.fillText(text, 0, (lineHeight - (ascent + descent)) / 2 + ascent);
    const data = ctx.getImageData(0, 0, width, height).data;
    const alpha = new Uint8ClampedArray(width * height);
    for (let i = 0; i < width * height; i++) alpha[i] = data[i * 4 + 3] ?? 0;
    const { left, top } = offsetWithin(wordmark, hero);
    return dotsFromMask(alpha, width, height, LETTER_SPACING).map((p) => ({
      ...p,
      x: p.x + left,
      y: p.y + top,
    }));
  }

  function mount(canvas: HTMLCanvasElement): void {
    const context = canvas.getContext('2d');
    const hero = canvas.closest<HTMLElement>('.hero');
    const wordmark = hero?.querySelector<HTMLElement>('.wordmark') ?? null;
    if (!context || !hero) return;
    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let width = 0;
    let height = 0;
    let letters: MaskPoint[] = [];
    let start = performance.now();
    let frame = 0;
    let ripples: { x: number; y: number; at: number }[] = [];

    // Returns [dx, dy, strength] for a dot at (x, y) given the live ripples.
    function nudge(x: number, y: number, now: number): [number, number, number] {
      let dx = 0;
      let dy = 0;
      let total = 0;
      for (const r of ripples) {
        const age = (now - r.at) / 1000;
        const vx = x - r.x;
        const vy = y - r.y;
        const dist = Math.hypot(vx, vy) || 1;
        const k = ripple(dist, age, WAVE);
        if (k <= 0.001) continue;
        dx += (vx / dist) * k * PUSH;
        dy += (vy / dist) * k * PUSH;
        total += k;
      }
      return [dx, dy, Math.min(1, total)];
    }

    function resize(): void {
      const rect = canvas.getBoundingClientRect();
      const dpr = Math.min(2, window.devicePixelRatio || 1);
      width = Math.max(1, Math.round(rect.width));
      height = Math.max(1, Math.round(rect.height));
      canvas.width = Math.round(width * dpr);
      canvas.height = Math.round(height * dpr);
      context!.setTransform(dpr, 0, 0, dpr, 0, 0);
      letters = wordmark ? wordmarkPoints(hero!, wordmark) : [];
      hero!.classList.toggle('has-dots', letters.length > 0);
    }

    // 0 while still on the globe, 1 once flat; centre of the picture first.
    function unfolded(seconds: number, lon: number): number {
      const delay = INTRO.unfoldAt + (Math.abs(lon) / (LON_SPAN / 2)) * INTRO.spread;
      return assemble(seconds / INTRO.unfold, delay / INTRO.unfold);
    }

    function draw(now: number): void {
      const seconds = reduceMotion ? 1e9 : (now - start) / 1000;
      const cycle = reduceMotion ? { progress: 1, strength: 1 } : climbCycle(seconds, TIMING);
      const narrow = width < height;
      const cx = width / 2;
      const cy = height / 2;
      const R = Math.min(width, height) * 0.4;
      const theta = START_ANGLE * (1 - easeOut(seconds / INTRO.spin));
      const intro = seconds < INTRO_END;
      context!.clearRect(0, 0, width, height);

      // Background and staircase on the coarse grid.
      const cols = Math.ceil(width / SPACING);
      const rows = Math.ceil(height / SPACING);
      for (let row = 0; row <= rows; row++) {
        for (let col = 0; col <= cols; col++) {
          const fx = col * SPACING + SPACING / 2;
          const fy = row * SPACING + SPACING / 2;
          const dot = dotField(
            fieldX(fx / width, narrow),
            fieldY(fy / height, narrow),
            cycle.progress,
            seconds,
            cycle.strength,
          );
          let px = fx;
          let py = fy;
          let alpha = dot.alpha;
          let radius = dot.radius * SPACING;
          if (intro) {
            const g = onGlobe(fx, fy, width, height, cx, cy, R, theta);
            const u = unfolded(seconds, g.lon);
            px = g.x + (fx - g.x) * u;
            py = g.y + (fy - g.y) * u;
            const shade = 0.06 + 0.94 * g.depth ** 2; // far side of the globe fades almost out
            alpha = dot.alpha * (shade + (1 - shade) * u);
            radius = dot.radius * SPACING * (g.persp + (1 - g.persp) * u);
          }
          const [nx, ny, k] = ripples.length ? nudge(px, py, now) : [0, 0, 0];
          context!.fillStyle = colour(
            Math.min(1, dot.warmth + k * 0.6),
            Math.min(1, alpha + k * 0.5),
          );
          context!.beginPath();
          context!.arc(px + nx, py + ny, radius * (1 + k * 1.1), 0, Math.PI * 2);
          context!.fill();
        }
      }

      // Wordmark on the fine grid.
      for (const point of letters) {
        let px = point.x;
        let py = point.y;
        let alpha = 0.96;
        let radius = LETTER_SPACING * 0.42;
        if (intro) {
          const g = onGlobe(point.x, point.y, width, height, cx, cy, R, theta);
          const u = unfolded(seconds, g.lon);
          px = g.x + (point.x - g.x) * u;
          py = g.y + (point.y - g.y) * u;
          const shade = 0.05 + 0.95 * g.depth ** 2;
          alpha = 0.96 * (shade + (1 - shade) * u);
          radius = LETTER_SPACING * 0.42 * (g.persp + (1 - g.persp) * u);
        }
        const [nx, ny] = ripples.length ? nudge(px, py, now) : [0, 0];
        context!.fillStyle = `rgba(255, 255, 255, ${alpha.toFixed(3)})`;
        context!.beginPath();
        context!.arc(px + nx, py + ny, radius, 0, Math.PI * 2);
        context!.fill();
      }
    }

    function loop(now: number): void {
      ripples = ripples.filter((r) => now - r.at < WAVE.life * 1000);
      draw(now);
      frame = requestAnimationFrame(loop);
    }

    hero.addEventListener('pointerdown', (event) => {
      if (reduceMotion) return;
      const rect = canvas.getBoundingClientRect();
      ripples.push({
        x: event.clientX - rect.left,
        y: event.clientY - rect.top,
        at: performance.now(),
      });
    });

    resize();
    if (reduceMotion) {
      draw(performance.now());
    } else {
      frame = requestAnimationFrame(loop);
    }

    // The wordmark font may land after the first layout.
    document.fonts?.ready.then(() => {
      resize();
      if (reduceMotion) draw(performance.now());
    });

    new ResizeObserver(() => {
      resize();
      if (reduceMotion) draw(performance.now());
    }).observe(canvas);

    // Pause while hidden without skipping ahead: the clock stops with the tab.
    let pausedAt = 0;
    document.addEventListener('visibilitychange', () => {
      if (reduceMotion) return;
      if (document.hidden) {
        pausedAt = performance.now();
        cancelAnimationFrame(frame);
      } else {
        if (pausedAt) start += performance.now() - pausedAt;
        pausedAt = 0;
        frame = requestAnimationFrame(loop);
      }
    });
  }

  for (const canvas of document.querySelectorAll<HTMLCanvasElement>('[data-hero-dots]')) {
    mount(canvas);
  }
</script>
