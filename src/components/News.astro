---
import { t, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = t(locale).news;
---

<section id="news" class="section" aria-labelledby="news-title" data-screen>
  <div class="container">
    <h2 id="news-title" data-reveal>
      <span
        data-dot-text
        data-dot-trigger="visible"
        data-dot-spacing="3"
        data-dot-radius="0.33"
        data-dot-rise="56"
        data-dot-spread="0.25"
      >
        {copy.heading}
      </span>
    </h2>
    <p class="news-line" data-reveal="2">
      {copy.empty}
    </p>
  </div>
</section>
