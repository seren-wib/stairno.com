---
import { t, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = t(locale).news;
---

<section class="section" aria-labelledby="news-title">
  <div class="container">
    <h2 id="news-title">{copy.heading}</h2>
    <p class="news-line">{copy.empty}</p>
  </div>
</section>
