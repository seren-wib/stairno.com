---
import type { Project } from '../data/projects';
import type { Locale } from '../i18n';

interface Props {
  project: Project;
  locale: Locale;
}

const { project, locale } = Astro.props;
---

<div class="project">
  <p class="project-name">{project.name[locale]}</p>
  <p class="project-description">{project.description[locale]}</p>
  <a class="project-link" href={project.url} target="_blank" rel="noopener noreferrer">
    <span>{project.url.replace('https://', '')}</span>
    <span class="project-arrow" aria-hidden="true">
      ↗
    </span>
  </a>
</div>
