---
import type { Project } from '../data/projects';
import type { Locale } from '../i18n';

interface Props {
  project: Project;
  locale: Locale;
}

const { project, locale } = Astro.props;
---

<a class="step-link" href={project.url} target="_blank" rel="noopener noreferrer">
  <span class="step-name">{project.name[locale]}</span>
  <span class="step-description">{project.description[locale]}</span>
  <span class="step-arrow" aria-hidden="true">
    ↗
  </span>
</a>
