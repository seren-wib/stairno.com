---
import { projects } from '../data/projects';
import { t, type Locale } from '../i18n';
import ProjectCard from './ProjectCard.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = t(locale).projects;
const INTERVAL = 5000;
---

<section id="projects" class="section projects" aria-labelledby="projects-title">
  <div class="container">
    <h2 id="projects-title" data-reveal>
      <span data-dot-text data-dot-trigger="visible" data-dot-spacing="2.5" data-dot-radius="0.4">
        {copy.heading}
      </span>
    </h2>
  </div>
  <div
    class="slider"
    data-slider
    data-reveal="2"
    data-interval={INTERVAL}
    aria-roledescription="carousel"
    aria-label={copy.heading}
  >
    <div class="slides" data-slides>
      {projects.map((project, index) => (
        <div
          class:list={['slide', `slide-${index + 1}`]}
          data-slide
          role="group"
          aria-roledescription="slide"
          aria-label={`${index + 1} / ${projects.length}`}
          aria-hidden={index === 0 ? 'false' : 'true'}
        >
          <div class="container slide-inner">
            <ProjectCard project={project} locale={locale} />
          </div>
        </div>
      ))}
    </div>
    <div class="container slider-controls">
      <div class="dots" role="tablist">
        {projects.map((project, index) => (
          <button
            type="button"
            class:list={['dot', `dot-${index + 1}`]}
            data-slider-dot
            data-index={index}
            role="tab"
            aria-selected={index === 0 ? 'true' : 'false'}
            aria-label={copy.goTo.replace('{name}', project.name[locale])}
          />
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  import { createSlider } from '../lib/slider';

  for (const root of document.querySelectorAll<HTMLElement>('[data-slider]')) {
    createSlider(root);
  }
</script>
