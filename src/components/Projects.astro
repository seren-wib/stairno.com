---
import { projects } from '../data/projects';
import { t, type Locale } from '../i18n';
import ProjectCard from './ProjectCard.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = t(locale).projects;
---

<section
  id="projects"
  class="section projects"
  aria-labelledby="projects-title"
  data-screen
  data-slider
  aria-roledescription="carousel"
  aria-label={copy.heading}
>
  <div class="container projects-heading">
    <h2 id="projects-title" data-reveal>
      <span
        data-dot-text
        data-dot-trigger="visible"
        data-dot-spacing="3"
        data-dot-radius="0.33"
        data-dot-rise="56"
        data-dot-spread="0.25"
        data-dot-color="star"
      >
        {copy.heading}
      </span>
    </h2>
  </div>
  <div class="slides" data-slides>
    {projects.map((project, index) => (
      <div
        class:list={['slide', `slide-${index + 1}`]}
        data-slide
        role="group"
        aria-roledescription="slide"
        aria-label={`${index + 1} / ${projects.length}`}
        aria-hidden={index === 0 ? 'false' : 'true'}
        inert={index === 0 ? undefined : true}
      >
        <div class="container slide-inner" data-reveal="2">
          <ProjectCard project={project} locale={locale} />
        </div>
      </div>
    ))}
  </div>
  <div class="container slider-controls">
    <div class="dots" role="tablist">
      {projects.map((project, index) => (
        <button
          type="button"
          class:list={['dot', `dot-${index + 1}`]}
          data-slider-dot
          data-index={index}
          role="tab"
          aria-selected={index === 0 ? 'true' : 'false'}
          aria-label={copy.goTo.replace('{name}', project.name[locale])}
        />
      ))}
    </div>
  </div>
</section>
