---
import { localePath, locales, t, type Locale } from '../i18n';
import { site } from '../data/site';
import '../styles/global.css';

interface Props {
  locale: Locale;
  path?: string;
  title?: string;
  description?: string;
  noindex?: boolean;
}

const { locale, path = '', noindex = false } = Astro.props;
const dictionary = t(locale);
const title = Astro.props.title ?? dictionary.meta.title;
const description = Astro.props.description ?? dictionary.meta.description;
const canonical = new URL(localePath(locale, path), site.url).href;
const ogLocale = locale === 'ko' ? 'ko_KR' : 'en_US';
const fontHref =
  'https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css';
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Apply the theme before paint (FR-15). Same rule as src/lib/theme.ts resolveTheme.
      (function () {
        var stored = null;
        try {
          stored = localStorage.getItem('theme');
        } catch (e) {}
        var theme =
          stored === 'light' || stored === 'dark'
            ? stored
            : window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light';
        document.documentElement.setAttribute('data-theme', theme);
        document.documentElement.style.colorScheme = theme;
      })();
    </script>
    <script is:inline>
      // Reveal styles only apply once scripts are known to run.
      document.documentElement.classList.add('js');
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    {!noindex &&
      locales.map((l) => (
        <link rel="alternate" hreflang={l} href={new URL(localePath(l, path), site.url).href} />
      ))}
    {!noindex && <link rel="alternate" hreflang="x-default" href={`${site.url}/`} />}
    <meta property="og:site_name" content={site.name} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:image" content={`${site.url}/og.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={dictionary.meta.title} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link rel="stylesheet" href={fontHref} />
    <slot name="head" />
  </head>
  <body>
    <slot />
    <script>
      import { createSlider } from '../lib/slider';
      import { createPageScroll } from '../lib/screens';

      const sliders = Array.from(document.querySelectorAll<HTMLElement>('[data-slider]')).map(
        (root) => createSlider(root),
      );
      createPageScroll(
        Array.from(document.querySelectorAll<HTMLElement>('[data-screen]')),
        sliders.map((slider) => slider.consume),
      );
    </script>
    <script>
      import { mountDotText } from '../lib/dot-text';

      const rootStyle = getComputedStyle(document.documentElement);
      for (const el of document.querySelectorAll<HTMLElement>('[data-dot-text]')) {
        const trigger = (el.dataset.dotTrigger ?? 'always') as 'always' | 'visible' | 'current';
        const spacing = Number(el.dataset.dotSpacing) || 4;
        const color =
          el.dataset.dotColor === 'star'
            ? () => rootStyle.getPropertyValue('--star').trim() || '#ffffff'
            : () =>
                getComputedStyle(el).getPropertyValue('--dot-text-color').trim() || 'currentColor';
        const settle = el.dataset.dotSettle === 'reveal' ? 'reveal' : 'keep';
        const radius = Number(el.dataset.dotRadius) || 0.45;
        const rise = Number(el.dataset.dotRise) || 0;
        const spread = el.dataset.dotSpread ? Number(el.dataset.dotSpread) : 0.5;
        mountDotText(el, { spacing, color, trigger, settle, radius, rise, spread });
      }
    </script>
    <script>
      // Scroll reveal for [data-reveal] elements (SDD 4.6). Replays every time an
      // element scrolls back into view.
      const targets = document.querySelectorAll<HTMLElement>('[data-reveal]');
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduce || !('IntersectionObserver' in window)) {
        targets.forEach((el) => el.classList.add('is-visible'));
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              entry.target.classList.toggle('is-visible', entry.isIntersecting);
            }
          },
          { threshold: 0.05, rootMargin: '0px 0px -4% 0px' },
        );
        targets.forEach((el) => observer.observe(el));
      }
    </script>
  </body>
</html>
